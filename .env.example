# Copy to .env and fill in. Never commit .env.

# From the Azure/Entra app registration (see SETUP.md)
AZURE_CLIENT_ID=

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Where the SQLite database lives. Point at a OneDrive folder to share between machines.
# "~" is expanded. Use .env.local for a per-machine override (it is also git-ignored).
DB_PATH=./data/tracker.db

# Default settings (can be changed later in the Settings page)
CLAUDE_MODEL=claude-haiku-4-5
CONFIDENCE_THRESHOLD=0.7
FOLLOW_UP_DAYS=14
APPLICATIONS_FOLDER=Job Applications

# Web server
HOST=127.0.0.1
PORT=8000
